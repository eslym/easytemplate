{
	"name": "@eslym/easytemplate",
	"description": "A very simple, featureless template engine",
	"version": "1.1.3",
	"module": "dist/esm/index.js",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.js",
			"types": "./dist/types/index.d.ts"
		},
		"./vite": {
			"import": "./dist/esm/vite.js",
			"require": "./dist/cjs/vite.js",
			"types": "./dist/types/vite.d.ts"
		},
		"./rollup": {
			"import": "./dist/esm/vite.js",
			"require": "./dist/cjs/vite.js",
			"types": "./dist/types/vite.d.ts"
		}
	},
	"devDependencies": {
		"@types/bun": "latest",
		"js-xxhash": "^4.0.0",
		"prettier": "^3.6.2",
		"vite": "^7.1.9"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
